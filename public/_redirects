# Netlify (and scripts/preview.mjs). Rules apply only to paths with no file.
# Cloudflare Pages ignores the catch-all rule (it reports it as an infinite
# loop) and serves index.html for unknown paths by itself, because the site
# has no top-level 404.html; missing /static/ files get static/404.html there.

# Missing assets are real 404s, not the app.
/static/*  /static/404.html  404

# Every other path gets the app. Status 200 makes this a rewrite: the browser
# keeps the requested URL, which the app reads.
/*  /index.html  200
